.PHONY: build new release test

build: ## build project
	@printf 'build\n'

# args: title
new: ## create new post
	@printf 'TITLE=%s\n' "$(TITLE)"

# args: version target?=all
release: ## publish release
	@printf 'VERSION=%s TARGET=%s\n' "$(VERSION)" "$(TARGET)"

test: ## run tests
	@printf 'test\n'
